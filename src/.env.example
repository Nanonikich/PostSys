POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
BACKEND_PORT=5000
ASPNETCORE_ENVIRONMENT=Production
JWT_SIGNING_KEY=change-me-to-a-long-random-secret-key-32+
JWT_ISSUER=PostSys
JWT_AUDIENCE=PostSys.Gui
# Optional allowed browser origin for production CORS
CORS_ORIGIN=
# Apply EF migrations on backend startup (true/false). For multi-replica use false + tools/run-migrations.cmd
POSTSYS_RUN_MIGRATIONS=true
# Observability profile (docker compose --profile observability)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
