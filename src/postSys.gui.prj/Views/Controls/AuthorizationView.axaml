<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PostSys.Gui.ViewModels"
             xmlns:loc="using:PostSys.Gui.Localization"
             x:Class="PostSys.Gui.Views.Controls.AuthorizationView"
             x:DataType="vm:AuthorizationViewModel">

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="0, 5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto"
          ColumnDefinitions="*, *, *"
          Margin="16"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          MaxWidth="420">
      <TextBox Grid.Column="1"
               Text="{Binding Email, Mode=TwoWay}"
               MaxLength="64"
               PlaceholderText="{loc:Loc Email}"/>
      <TextBox Grid.Row="1"
               Grid.Column="1"
               Text="{Binding Password, Mode=TwoWay}"
               PasswordChar="*"
               MaxLength="64"
               PlaceholderText="{loc:Loc Password}"/>
      <CheckBox Grid.Row="2"
                Grid.Column="1"
                Margin="0,8"
                Content="{loc:Loc RememberMe}"
                IsChecked="{Binding RememberMe}"/>
      <Button Grid.Row="3"
              Grid.Column="1"
              Content="{loc:Loc LogIn}"
              Height="44"
              Margin="0, 10"
              VerticalContentAlignment="Center"
              HorizontalContentAlignment="Center"
              HorizontalAlignment="Stretch"
              Command="{Binding AuthorizationCommand}"/>
    </Grid>
  </ScrollViewer>
</UserControl>