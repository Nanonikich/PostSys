<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:locConverters="using:PostSys.Gui.Converters"
             xmlns:vm="using:PostSys.Gui.ViewModels"
             x:Class="PostSys.Gui.Views.Controls.OrderDescriptionView"
             x:DataType="vm:OrderDescriptionViewModel">

  <UserControl.Resources>
    <locConverters:FullnameToStringConverter x:Key="FullnameToStringConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Margin="10">
    <Border BorderBrush="Black" BorderThickness="2" CornerRadius="10" Padding="10">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapConverter}}"
               Width="100" Height="100" Margin="5"
               Grid.Column="0"/>
          <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, Auto" Margin="10">
            <TextBlock Text="{Binding Address}" FontWeight="Bold"/>
            <TextBlock Text="{Binding ClientInfo.Fullname, Converter={StaticResource FullnameToStringConverter}}" Margin="0, 5" Grid.Row="1"/>
            <TextBlock Text="{Binding ClientInfo.PhoneNumber}" Margin="0, 5" Grid.Row="2"/>
            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToStringConverter}}"
                       Margin="0, 5" Grid.Row="3"/>
          </Grid>
          <Button Content="Select"
                  Command="{Binding SelectOrderCommand}"
                  Grid.Column="2"
                  Margin="10, 0"
                  Width="100"
                  Height="100"
                  CornerRadius="10"
                  Background="#FF007ACC"
                  Foreground="#FFFFFF"
                  VerticalAlignment="Center"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"/>
      </Grid>
    </Border>
  </StackPanel>

</UserControl>
