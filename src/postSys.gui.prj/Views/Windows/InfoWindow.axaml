<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PostSys.Gui.ViewModels"
        Width="300" Height="223"
        x:Class="PostSys.Gui.Views.Windows.InfoWindow"
        x:DataType="vm:InfoWindowViewModel"
        Icon="avares://PostSys.Gui.Common/Assets/logo.ico"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="About">

  <Window.Styles>
    <Style Selector="TextBlock.SupportTextBlockStyle">
      <Setter Property="Foreground" Value="Blue"/>
        <Setter Property="Margin" Value="5, 0"/>
      </Style>
      <Style Selector="StackPanel.InternalStackPanelStyle">
        <Setter Property="Margin" Value="0, 5"/>
      </Style>
  </Window.Styles>

  <Grid RowDefinitions="2*, 3*, *" Margin="10">
    <StackPanel>
      <TextBlock>PostSys</TextBlock>
      <TextBlock>Delivery system</TextBlock>
      <TextBlock Text="{Binding Version}" Margin="0, 12"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
      <Border Classes="BorderOfWindow"/>
      <TextBlock Margin="0, 5">Technical support</TextBlock>
      <StackPanel Orientation="Horizontal" Classes="InternalStackPanelStyle">
        <TextBlock Text="📞"/>
        <TextBlock Text="+ 7 911 548 15 25" Classes="SupportTextBlockStyle"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Classes="InternalStackPanelStyle">
        <TextBlock Text="✉"/>
        <TextBlock Text="nanonikich@gmail.com" Classes="SupportTextBlockStyle"/>
      </StackPanel>
      <Border Classes="BorderOfWindow"/>
    </StackPanel>
      <TextBlock Grid.Row="2" TextWrapping="Wrap">© Exclusive rights belong to "Nanonikich"</TextBlock>
  </Grid>

</Window>
